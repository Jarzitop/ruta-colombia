{
  "name": "ruta-colombia",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android --clean",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate-dataset.mjs src/data/synthetic/dev.dataset.json",
    "doctor": "npx expo-doctor@latest",
    "build:apk": "npx eas-cli@latest build --platform android --profile preview",
    "test:validator": "node scripts/test-validator.mjs",
    "test:routing": "node --experimental-strip-types scripts/test-routing.mjs",
    "test:planner": "node --experimental-strip-types scripts/test-planner.mjs",
    "test:map": "node --experimental-strip-types scripts/test-map.mjs",
    "test:expected-trips": "node --experimental-strip-types scripts/test-expected-trips.mjs",
    "verify:synthetic-trips": "node --experimental-strip-types scripts/verify-expected-trips.mjs src/data/synthetic/dev.dataset.json src/data/synthetic/expected-trips.json",
    "verify:bogota-pilot": "node --experimental-strip-types scripts/verify-bogota-pilot.mjs",
    "test:bogota-handoff": "node --experimental-strip-types scripts/test-bogota-handoff.mjs",
    "test:catalog-notice": "node --experimental-strip-types scripts/test-catalog-notice.mjs",
    "test:gtfs-calendar": "node --experimental-strip-types scripts/test-gtfs-calendar.mjs",
    "test:scheduled": "node --experimental-strip-types scripts/test-scheduled.mjs",
    "verify:private-temporal": "node --experimental-strip-types scripts/verify-private-temporal.mjs",
    "check:private-data": "node scripts/assert-no-private-data.mjs",
    "test:private-data-gate": "node scripts/test-private-data-gate.mjs",
    "test:synthetic-schedule": "node --experimental-strip-types scripts/test-synthetic-schedule.mjs",
    "check:preview-data": "node --experimental-strip-types scripts/check-preview-data.mjs",
    "test:preview-data": "node --experimental-strip-types scripts/test-preview-data.mjs",
    "prebuild:apk": "npm run check:private-data && npm run check:preview-data && npm run test:synthetic-schedule && npm run typecheck"
  },
  "dependencies": {
    "@maplibre/maplibre-react-native": "11.5.0",
    "expo": "57.0.27",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "6.0.3"
  },
  "packageManager": "npm@10.9.2"
}
